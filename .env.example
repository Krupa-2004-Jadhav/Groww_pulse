DATABASE_URL="file:./dev.db"

# twelvedata | replay — see README for the tradeoff.
# replay is the safe default: deterministic, no live dependency, no credit spend.
MARKET_PROVIDER=replay

# Required only when MARKET_PROVIDER=twelvedata. Get one free at twelvedata.com.
TWELVEDATA_API_KEY=

# Optional: fixes the ReplayProvider's random walk for reproducible demos/tests.
REPLAY_SEED=pulse-demo

# Optional: overrides the market-index proxy used for beta (plan §3, Phase 3). Defaults to SPY.
MARKET_INDEX_SYMBOL=SPY
