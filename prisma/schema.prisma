// Pulse — data model per Pulse_Implementation_Plan.pdf §4.
//
// SQLite for local dev (explicitly permitted by the plan: "SQLite can
// substitute for local dev but Postgres is the target"). Two Postgres
// primitives don't exist here and are substituted, noted at each use site:
//   - BIGSERIAL / gen_random_uuid()  -> Prisma autoincrement()/cuid()
//   - GREATEST(a, b)                 -> SQLite's multi-arg MAX(a, b) (see
//     lib/watermark.ts) — same semantics, different spelling.
// Swapping datasource provider to "postgresql" and adjusting those two call
// sites is the only work needed to move to the target DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- reference & market data ----------

model Symbol {
  symbol   String @id
  name     String
  exchange String @default("US")

  quoteLatest   QuoteLatest?
  bars          BarDaily[]
  stats         SymbolStats?
  events        SymbolEvent[]
  watchlistItems WatchlistItem[]
}

model QuoteLatest {
  symbol     String   @id
  price      Float
  dayOpen    Float?
  dayHigh    Float?
  dayLow     Float?
  prevClose  Float?
  volume     Float?
  asOf       DateTime // when the price happened (from provider)
  receivedAt DateTime // when we learned it
  source     String

  instrument Symbol @relation(fields: [symbol], references: [symbol])
}

model BarDaily {
  symbol    String
  barDate   DateTime // stored at UTC midnight; compared by date only
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  volume    Float?
  adjFactor Float    @default(1.0) // corporate-action adjustment

  instrument Symbol @relation(fields: [symbol], references: [symbol])

  @@id([symbol, barDate])
}

// Rolling stats recomputed by the rollup job.
model SymbolStats {
  symbol        String   @id
  vol20d        Float? // stddev of daily returns, 20d
  avgVolume20d  Float?
  high52w       Float?
  low52w        Float?
  beta          Float? // vs market index
  updatedAt     DateTime

  instrument Symbol @relation(fields: [symbol], references: [symbol])
}

// ---------- append-only event log ----------

model SymbolEvent {
  seq               Int       @id @default(autoincrement()) // the watermark unit
  symbol            String
  eventType         String // price_move|volume_surge|vol_expansion|relative_perf|filing|week52_break|gap
  tier              String // low|medium|high
  score             Float // 0..100 attention sub-contribution or event score
  reason            String // plain-English sentence
  occurredAt        DateTime
  resolvedAt        DateTime? // NULL = still active (Track A)
  triggerMetric     String? // e.g. 'z_score' — for reconciliation
  triggerThreshold  Float?
  clearStreak       Int       @default(0) // hysteresis counter
  dedupeKey         String    @unique // symbol+type+date-bucket+tier

  instrument      Symbol           @relation(fields: [symbol], references: [symbol])
  userEventStates UserEventState[]

  @@index([symbol])
  @@index([resolvedAt])
}

// ---------- watchlists ----------

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  watchlists Watchlist[]
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id])
  items      WatchlistItem[]
  readStates ReadState[] // one per (userId, watchlistId); MVP has a single owning user, so effectively one
}

model WatchlistItem {
  id            String    @id @default(cuid())
  watchlistId   String
  symbol        String
  position      Float // fractional rank, avoids reorder collisions
  addedAt       DateTime  @default(now())
  seedWatermark Int // events before this are NOT backfilled to the user

  watchlist  Watchlist @relation(fields: [watchlistId], references: [id])
  instrument Symbol    @relation(fields: [symbol], references: [symbol])

  @@unique([watchlistId, symbol]) // duplicate add = no-op
}

// ---------- per-user read state (Track: delivery) ----------
model ReadState {
  userId      String
  watchlistId String
  watermark   Int       @default(0) // highest CONFIRMED-delivered seq
  lastSeenAt  DateTime? // coarse "user opened the list"

  watchlist Watchlist @relation(fields: [watchlistId], references: [id])

  @@id([userId, watchlistId])
}

// ---------- per-user, per-event acknowledgement (Track B) ----------
model UserEventState {
  userId         String
  eventId        Int
  acknowledgedAt DateTime?
  dismissedAt    DateTime?

  event SymbolEvent @relation(fields: [eventId], references: [seq])

  @@id([userId, eventId])
}
